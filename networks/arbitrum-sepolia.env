# Arbitrum Sepolia. Public config only; no secrets here.
# Load with:  set -a; source networks/arbitrum-sepolia.env; set +a
NETWORK_NAME="Arbitrum Sepolia"
# Symbol of the gas token, shown in the wallet UI.
NATIVE_SYMBOL=ETH
CHAIN_ID=421614
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
EXPLORER_URL=https://sepolia.arbiscan.io/
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# Deployed 2026-11-09: ERC1271_VERSION 2 (signed approvals need both keys).
# Accounts from the earlier factory 0x60319237e8dd2D661eBcF8E6933458BD78Ce146d keep working.
FACTORY_ADDRESS=0xb29eDc6A27C24c0579Bd42Fe4f86ad36F36d33DA

E2E_THRESHOLD_WEI=1000000000000000
E2E_SEND_UNDER_WEI=100000000000000
E2E_SEND_OVER_WEI=2000000000000000
E2E_VERIFICATION_GAS_LIMIT=800000
E2E_CALL_GAS_LIMIT=100000
E2E_PRE_VERIFICATION_GAS=100000
E2E_CLIENT_ORIGIN=https://haptix-e2e.local

# --- Agent budgets demo (scripts/agent-e2e.mjs) ---
# The agent's 24h budget and one payment; the budget fits exactly two payments.
AGENT_E2E_BUDGET_WEI=200000000000000
AGENT_E2E_PAYMENT_WEI=100000000000000
# Call gas for grant and revoke, which write several storage slots.
AGENT_E2E_GRANT_CALL_GAS=600000
