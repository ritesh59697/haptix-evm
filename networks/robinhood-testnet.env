# Robinhood Chain testnet (Arbitrum Orbit). Public config only; no secrets here.
# Load with:  set -a; source networks/robinhood-testnet.env; set +a
# Source: https://docs.robinhood.com/chain/connecting (checked 2026-11-05)
NETWORK_NAME="Robinhood Chain testnet"
# Symbol of the gas token, shown in the wallet UI.
NATIVE_SYMBOL=ETH
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
EXPLORER_URL=https://explorer.testnet.chain.robinhood.com/
ENTRYPOINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
# Filled in after `forge script script/DeployMainnet.s.sol` runs on this chain.
# Deployed 2026-11-09: ERC1271_VERSION 2 (signed approvals need both keys).
# Accounts from the earlier factory 0x60319237e8dd2D661eBcF8E6933458BD78Ce146d keep working
# and keep the old one-key signature rule; only new accounts get the new one.
FACTORY_ADDRESS=0xCd12906D03812f85a845F5f28705d0F353375980

# --- End-to-end demo (scripts/chain-e2e.mjs) ---
# Per-op spend limit for the demo account: above it, a second passkey is required.
E2E_THRESHOLD_WEI=1000000000000000
# A send under the limit (one passkey) and one over it (two passkeys).
E2E_SEND_UNDER_WEI=100000000000000
E2E_SEND_OVER_WEI=2000000000000000
# UserOp gas ceilings. Actual gas used is read back from the receipt.
E2E_VERIFICATION_GAS_LIMIT=800000
E2E_CALL_GAS_LIMIT=100000
E2E_PRE_VERIFICATION_GAS=100000
# Origin written into the software signer's clientDataJSON (not checked on-chain).
E2E_CLIENT_ORIGIN=https://haptix-e2e.local

# --- Agent budgets demo (scripts/agent-e2e.mjs) ---
# The agent's 24h budget and one payment; the budget fits exactly two payments.
AGENT_E2E_BUDGET_WEI=200000000000000
AGENT_E2E_PAYMENT_WEI=100000000000000
# Call gas for grant and revoke, which write several storage slots.
AGENT_E2E_GRANT_CALL_GAS=600000

# --- Testnet-only demo DEX (script/DeployDemoDex.s.sol) ---
# Worthless mintable tokens and a fixed-price router, for the agent trading demo.
DEMO_DEX_ALLOWED=true
DEMO_USD_PRICE=1
DEMO_STOCK_PRICE=100
DEMO_USD_TOKEN=0x70145655EAc4d51Ac4F6339167fFf5B0BD49503D
DEMO_STOCK_TOKEN=0xA1e7395f6812921B31Cb799Dc939F16ac9C06840
DEMO_SWAP_ROUTER=0xccCfD00E0A882f586b84D37029656705715b0921

# What the extension shows and lets agents trade. Symbols and decimals are read from chain.
WALLET_TOKENS=0x70145655EAc4d51Ac4F6339167fFf5B0BD49503D,0xA1e7395f6812921B31Cb799Dc939F16ac9C06840
SWAP_ROUTER=0xccCfD00E0A882f586b84D37029656705715b0921

# --- Agent trading demo (scripts/agent-trade-e2e.mjs), in 18-decimal demo tokens ---
AGENT_TRADE_BUDGET_WEI=200000000000000000000
AGENT_TRADE_PAYMENT_WEI=100000000000000000000
AGENT_TRADE_MIN_OUT_WEI=1000000000000000000
