{
  "manifest_version": 3,
  "name": "Haptix",
  "version": "0.2.0",
  "description": "Passkey wallet on testnet: Touch ID plus a second key, spend limits, agent budgets and a guardian. Creates real passkeys and testnet accounts.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Haptix",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
